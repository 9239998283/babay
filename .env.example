# Public Supabase values are safe to expose in the browser. Never add the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# WhatsApp phone number in international format, digits only (without +).
NEXT_PUBLIC_WHATSAPP_PHONE=79990000000

# Used for canonical metadata and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Server-only pepper for database-backed login/order throttling. Generate at least 32 random bytes.
# Never prefix this value with NEXT_PUBLIC_ and never commit the real value.
AUTH_RATE_LIMIT_SECRET=replace-with-a-long-random-secret
